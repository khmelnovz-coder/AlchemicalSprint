# Временные файлы Python (кэш компиляции)
__pycache__/
*.pyc
*.pyo
*.pyd

# Виртуальное окружение (папка с установленной библиотекой arcade)
.venv/
venv/
ENV/

# Настройки среды разработки PyCharm (чтобы твои окна не мешали ребятам)
.idea/

# База данных SQLite (чтобы у каждого игрока локально копились свои рекорды, а не перезаписывали общие)
*.db
*.sqlite3
